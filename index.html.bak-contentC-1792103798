<script src="/libs/gsap.min.js"></script>
<script>
(function(){
  const CARDS = [
    { cls:'orig',  tag:'ОРИГИНАЛ', play:'▶',  title:'Выставили рилс',                    sub:'Набрал 200–1000 просмотров',           views:'200–1000', vlabel:'просмотров' },
    { cls:'dup',   tag:'БЕЗ УНИКАЛИЗАЦИИ', play:'⏸', title:'Повторно выставить нельзя',  sub:'Без уникализации видео не пропустят совсем', views:'0', vlabel:'просмотров' },
    { cls:'good',  tag:'ВЕРСИЯ 1', play:'🎬', title:'Уникализация № 1',                 sub:'Добавляет ещё 1000–5000 просмотров',  views:'+1000–5000', vlabel:'просмотров' },
    { cls:'good',  tag:'ВЕРСИЯ 2', play:'🎬', title:'Уникализация № 2',                 sub:'Каждая версия — новый охват',          views:'+1000–5000', vlabel:'просмотров' },
    { cls:'good',  tag:'ВЕРСИЯ 3', play:'🎬', title:'Уникализация № 3',                 sub:'И так до бесконечности',               views:'+1000–5000', vlabel:'просмотров' },
    { cls:'good',  tag:'🔥 ЗАЛЕТЕЛ', play:'🚀', title:'Ролик может залететь',           sub:'100 — 1 000 000 просмотров',           views:'до 1 000 000', vlabel:'просмотров' },
    { cls:'good',  tag:'ИТОГ', play:'✅',  title:'Снимать заново не нужно',             sub:'Один рилс работает снова и снова',     views:'∞', vlabel:'охват' },
  ];

  const MAX_VISIBLE = 7, HALF = 3;
  const FAN = [
    { rot:-21, scale:0.7756, x:-30, y:7.3, z:1 },
    { rot:-14, scale:0.8498, x:-22, y:4.0, z:2 },
    { rot:-7,  scale:0.9346, x:-11, y:1.3, z:3 },
    { rot:0,   scale:1.0,    x:0,   y:0.0, z:10 },
    { rot:7,   scale:0.9346, x:11,  y:1.3, z:3 },
    { rot:14,  scale:0.8498, x:22,  y:4.0, z:2 },
    { rot:21,  scale:0.7756, x:30,  y:7.3, z:1 },
  ];
  function mult(w){ if(w<480)return .28; if(w<640)return .38; if(w<768)return .5; if(w<1024)return .75; return 1; }
  function hmult(w){ let ideal = w<480?22*16 : w<640?26*16 : w<768?28*16 : w<1024?34*16 : 38*16;
    const avail = innerHeight*0.7; return avail>=ideal ? 1 : avail/ideal; }

  const layout = document.getElementById('fanLayout');
  const dotsEl = document.getElementById('dots');
  // старт с карточки «Оригинал» (индекс 0) — она встаёт в центр веера
  const FIRST = 0;
  let center = FIRST, animating = false, entered = false, prevVisible = new Set(), dir = 'right';

  CARDS.forEach((c,i)=>{
    const el = document.createElement('div');
    el.className = 'fan-card ' + c.cls;
    el.innerHTML = `<div class="face">
      <div class="fc-tag">${c.tag}</div>
      <div class="fc-play">${c.play}</div>
      <div class="fc-title">${c.title}</div>
      <div class="fc-sub">${c.sub}</div>
      <div class="fc-views">👁 ${c.views}<small>${c.vlabel}</small></div>
    </div>`;
    layout.appendChild(el);
  });
  const els = [...layout.querySelectorAll('.fan-card')];

  CARDS.forEach((_,i)=>{ const d=document.createElement('span'); dotsEl.appendChild(d); });
  const dots = [...dotsEl.children];

  const total = CARDS.length, needsPager = true; // всегда листаем: видимых 7 из N

  function visibleMap(c){
    const m = new Map();
    if(!needsPager){ CARDS.forEach((_,i)=>m.set(i,i)); return m; }
    for(let s=0;s<MAX_VISIBLE;s++) m.set(((c+s-HALF)%total+total)%total, s);
    return m;
  }
  function slotCfg(slot){ return needsPager ? FAN[slot] : (function(){
    const c=total>>1, dist=total>1?(slot-c)/c:0, ad=Math.abs(dist);
    return { rot:dist*21, scale:1-0.2244*ad*ad, x:dist*30, y:ad*ad*7.3, z:10-Math.abs(slot-c) };
  })(); }

  let layoutToken = 0;
  function layoutCards(){
    const token = ++layoutToken;
    const m = mult(innerWidth), h = hmult(innerWidth);
    const vm = visibleMap(center);
    let done=0; const cnt=vm.size;
    const fin=()=>{ if(++done>=cnt && token===layoutToken){ animating=false; entered=true; } };
    els.forEach((el,idx)=>{
      const slot = vm.get(idx);
      const was = prevVisible.has(idx);
      if(slot!==undefined){
        const {x,y,rot,scale,z} = slotCfg(slot);
        const tgt = { x:x*m+'rem', y:y*h+'rem', rotation:rot, scale, opacity:1, zIndex:z };
        if(!entered){
          gsap.set(el,{x:0,y:12*h+'rem',rotation:0,scale:.5,opacity:0,zIndex:z});
          gsap.to(el,{...tgt,duration:1.2,ease:'elastic.out(1.05,.78)',delay:.2+slot*.06,onComplete:fin});
        } else if(!was){
          const ex = dir==='right'?40:-40;
          gsap.set(el,{x:ex+'rem',y:y*h+'rem',rotation:dir==='right'?30:-30,scale:.5,opacity:0,zIndex:z});
          gsap.to(el,{...tgt,duration:.6,ease:'power2.out',onComplete:fin});
        } else {
          gsap.to(el,{...tgt,duration:.5,ease:'power2.out',onComplete:fin});
        }
      } else if(was){
        const ex = dir==='right'?-40:40;
        gsap.set(el,{zIndex:0});
        gsap.to(el,{x:ex+'rem',opacity:0,scale:.5,rotation:dir==='right'?-30:30,duration:.4,ease:'power2.in'});
      } else {
        gsap.set(el,{opacity:0,scale:.3,x:0,y:0,zIndex:0});
      }
    });
    prevVisible = new Set(vm.keys());
    dots.forEach((d,i)=>d.classList.toggle('on', i===center));
    animating=true;
  }

  function cycle(d){
    if(!needsPager) return;
    dir = d; center = d==='right' ? (center+1)%total : (center-1+total)%total;
    layoutCards();
  }
  document.getElementById('next').onclick=()=>cycle('right');
  document.getElementById('prev').onclick=()=>cycle('left');

  // свайп — тройная страховка (pointer + touch), ловим на document
  const stage = document.querySelector('.fan-stage');
  let sx=0, sy=0, tracking=false;
  const begin=(x,y)=>{ tracking=true; sx=x; sy=y; };
  const move=(x,y,e)=>{
    if(!tracking) return;
    const dx=x-sx, dy=y-sy;
    if(Math.abs(dx)>8 && Math.abs(dx)>Math.abs(dy)){ if(e&&e.cancelable) e.preventDefault(); }
  };
  const end=(x,y)=>{
    if(!tracking) return; tracking=false;
    const dx=x-sx, dy=y-sy;
    if(Math.abs(dx)>30 && Math.abs(dx)>Math.abs(dy)) cycle(dx<0?'right':'left');
  };

  // Touch — единственный обработчик на телефоне (без дубля с pointer)
  let usedTouch = false;
  stage.addEventListener('touchstart',e=>{ usedTouch=true; const t=e.touches[0]; begin(t.clientX,t.clientY); },{passive:true});
  stage.addEventListener('touchmove',e=>{ const t=e.touches[0]; move(t.clientX,t.clientY,e); },{passive:false});
  stage.addEventListener('touchend',e=>{ const t=e.changedTouches[0]; end(t.clientX,t.clientY); },{passive:true});

  // Pointer (мышь + браузеры) — игнорим, если уже был touch
  stage.addEventListener('pointerdown',e=>{ if(e.pointerType==='touch' && usedTouch) return; if(e.pointerType==='mouse'&&e.button!==0) return; begin(e.clientX,e.clientY); });
  window.addEventListener('pointermove',e=>{ if(e.pointerType==='touch' && usedTouch) return; move(e.clientX,e.clientY,e); });
  window.addEventListener('pointerup',e=>{ if(e.pointerType==='touch' && usedTouch) return; end(e.clientX,e.clientY); });
  window.addEventListener('pointercancel',()=>{ tracking=false; });

  stage.addEventListener('dragstart',e=>e.preventDefault());

  addEventListener('resize',()=>{ if(!animating) layoutCards(); });

  // ── Анимация входа запускается при докрутке до секции (а не при загрузке) ──
  gsap.set(els,{opacity:0,scale:.3,x:0,y:0,zIndex:0});
  (function(){
    const sec = document.getElementById('why') || document.querySelector('.fan-stage');
    let started = false;
    const start = () => {
      if(started) return; started = true;
      layoutCards();
    };
    if('IntersectionObserver' in window && sec){
      const io = new IntersectionObserver((entries)=>{
        entries.forEach(en=>{ if(en.isIntersecting){ start(); io.disconnect(); } });
      }, { threshold:0.25 });
      io.observe(sec);
      // страховка: если секция уже видна при загрузке — запустим сразу
      const r = sec.getBoundingClientRect();
      if(r.top < innerHeight*0.6 && r.bottom > 0) start();
    } else {
      start();
    }
  })();
})();
</script>
