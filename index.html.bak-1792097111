<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Uniqpost — превью</title>
<style>
  :root {
    --bg: #07080c;
    --panel: #0c0f16;
    --panel-2: #10141d;
    --line: rgba(60,130,255,.16);
    --neon: #2f7bff;
    --neon-2: #58a6ff;
    --neon-soft: rgba(47,123,255,.14);
    --text: #e8ecf4;
    --muted: #7c8699;
    --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--text);
    min-height:100vh;
    background-image:
      radial-gradient(900px 500px at 15% -10%, rgba(47,123,255,.14), transparent 60%),
      radial-gradient(700px 400px at 100% 0%, rgba(47,123,255,.08), transparent 55%);
    background-attachment: fixed;
  }
  a { color: inherit; text-decoration: none; }

  /* ── Верхняя навигация ── */
  .nav {
    display:flex; align-items:center; gap:1.6rem;
    padding: 1rem 1.8rem;
    border-bottom:1px solid var(--line);
    backdrop-filter: blur(12px);
    position: sticky; top:0; z-index:50;
    background: rgba(7,8,12,.72);
  }
  .brand { display:flex; align-items:center; gap:.55rem; font-weight:800; font-size:1.05rem; letter-spacing:-.02em; }
  .brand .dot {
    width:11px; height:11px; border-radius:50%;
    background: var(--neon);
    box-shadow: 0 0 12px var(--neon), 0 0 22px rgba(47,123,255,.6);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse { 0%,100%{opacity:.65; transform:scale(.92)} 50%{opacity:1; transform:scale(1.08)} }
  .nav-links { display:flex; gap:1.4rem; font-size:.86rem; color:var(--muted); margin-left:1rem; }
  .nav-links span { cursor:pointer; transition:color .18s; }
  .nav-links span:hover { color:var(--text); }
  .nav-links .active { color:var(--neon-2); }
  .nav-right { margin-left:auto; display:flex; align-items:center; gap:.8rem; }
  .btn {
    border:none; border-radius:100px; padding:.55rem 1.15rem; font-family:var(--font);
    font-size:.82rem; font-weight:600; cursor:pointer; transition:all .18s;
  }
  .btn-ghost { background:transparent; color:var(--muted); }
  .btn-ghost:hover { color:var(--text); }
  .btn-neon {
    background: linear-gradient(135deg,#2f7bff,#0d4ea8); color:#fff;
    box-shadow: 0 0 18px rgba(47,123,255,.45), 0 6px 22px -8px rgba(47,123,255,.7);
  }
  .btn-neon:hover { box-shadow: 0 0 28px rgba(47,123,255,.7), 0 8px 26px -8px rgba(47,123,255,.9); transform:translateY(-1px); }

  /* ── Общий layout ── */
  .wrap { max-width:1180px; margin:0 auto; padding: 2.2rem 1.8rem 4rem; }
  .head { display:flex; align-items:flex-end; justify-content:space-between; gap:1rem; margin-bottom:1.6rem; flex-wrap:wrap; }
  .head h1 { font-size:1.7rem; font-weight:800; letter-spacing:-.025em; }
  .head p { color:var(--muted); font-size:.88rem; margin-top:.35rem; }

  /* ── Карточки статистики ── */
  .stats { display:grid; grid-template-columns:repeat(4,1fr); gap:.9rem; margin-bottom:1.6rem; }
  .stat {
    background: linear-gradient(160deg, rgba(20,26,38,.95), rgba(11,15,22,.95));
    border:1px solid var(--line); border-radius:16px; padding:1.1rem 1.15rem;
    position:relative; overflow:hidden; transition:border-color .3s, transform .3s, box-shadow .3s;
  }
  .stat:hover { border-color:rgba(47,123,255,.45); transform:translateY(-2px); box-shadow:0 18px 36px -22px rgba(47,123,255,.6); }
  .stat:before {
    content:""; position:absolute; inset:0 auto auto 0; width:100%; height:1px;
    background: linear-gradient(90deg, transparent, rgba(47,123,255,.6), transparent);
  }
  .stat .ico { position:absolute; top:.9rem; right:1rem; font-size:1.05rem; opacity:.5; }
  .stat .lbl { color:var(--muted); font-size:.7rem; text-transform:uppercase; letter-spacing:.07em; font-weight:600; }
  .stat .val { font-size:1.75rem; font-weight:800; margin-top:.4rem; letter-spacing:-.03em; }
  .stat .val em { font-style:normal; color:var(--neon-2); }
  .stat .sub { color:var(--muted); font-size:.7rem; margin-top:.25rem; }

  /* ── Панели ── */
  .grid { display:grid; grid-template-columns: 1.35fr 1fr; gap:1.2rem; }
  .card {
    background: linear-gradient(160deg, rgba(19,24,35,.92), rgba(11,15,22,.92));
    border:1px solid var(--line); border-radius:18px; padding:1.35rem 1.4rem;
    box-shadow:0 26px 60px -40px rgba(0,0,0,.9);
  }
  .card h2 { font-size:.98rem; font-weight:700; margin-bottom:1.05rem; display:flex; align-items:center; gap:.5rem; }
  .card h2 .tick { width:6px; height:6px; border-radius:50%; background:var(--neon); box-shadow:0 0 10px var(--neon); }
  .card h2 .cnt { margin-left:auto; font-size:.7rem; font-weight:600; color:var(--muted);
    border:1px solid var(--line); border-radius:100px; padding:.12rem .5rem; }

  /* строки аккаунтов */
  .sched { margin-top:.2rem; }
  .sched-row {
    display:flex; align-items:center; gap:.7rem; padding:.7rem .8rem; border-radius:12px;
    border:1px solid var(--line); margin-bottom:.55rem; background:rgba(255,255,255,.015);
    transition:border-color .25s, background .25s, transform .25s;
  }
  .sched-row:hover { border-color:rgba(47,123,255,.4); background:rgba(47,123,255,.05); transform:translateX(2px); }
  .sched-row:last-child { margin-bottom:0; }
  .acc { display:flex; align-items:center; gap:.5rem; font-size:.82rem; font-weight:600; }
  .acc .ic {
    width:30px; height:30px; border-radius:9px; display:grid; place-items:center; font-size:.88rem;
    background:var(--neon-soft); border:1px solid var(--line);
  }
  .time { margin-left:auto; font-variant-numeric: tabular-nums; font-size:.74rem; color:var(--muted); font-weight:600; }
  .badge {
    font-size:.66rem; padding:.2rem .55rem; border-radius:100px; font-weight:600;
    border:1px solid var(--line); color:var(--muted);
  }
  .badge.on { color:var(--neon-2); border-color:rgba(47,123,255,.4); background:var(--neon-soft); }

  /* очередь публикаций */
  .qitem { display:flex; gap:.75rem; align-items:center; padding:.7rem .55rem; border-radius:12px;
    border-bottom:1px solid var(--line); transition:background .25s; }
  .qitem:hover { background:rgba(47,123,255,.05); }
  .qitem:last-child { border-bottom:none; }
  .thumb {
    width:58px; height:40px; border-radius:9px; flex:none;
    background: repeating-linear-gradient(135deg,#141a26,#141a26 8px,#0e1320 8px,#0e1320 16px);
    border:1px solid var(--line); display:grid; place-items:center; color:var(--neon-2); font-size:.85rem;
  }
  .qmeta { flex:1; min-width:0; }
  .qmeta .t { font-size:.83rem; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .qmeta .s { font-size:.72rem; color:var(--muted); margin-top:.18rem; }
  .pill { font-size:.66rem; padding:.24rem .6rem; border-radius:100px; font-weight:600; white-space:nowrap;
    font-variant-numeric:tabular-nums; }
  .pill.done { color:#5bd67a; border:1px solid rgba(91,214,122,.35); background:rgba(91,214,122,.08); }
  .pill.wait { color:var(--neon-2); border:1px solid rgba(47,123,255,.4); background:var(--neon-soft); }
  .pill.proc { color:#ffcf5b; border:1px solid rgba(255,207,91,.35); background:rgba(255,207,91,.08); }

  /* полоса прогресса */
  .bar { height:6px; border-radius:100px; background:rgba(255,255,255,.06); overflow:hidden; margin-top:1rem; }
  .bar i { display:block; height:100%; width:68%; border-radius:100px;
    background:linear-gradient(90deg,#0d4ea8,#2f7bff,#58a6ff);
    box-shadow:0 0 14px rgba(47,123,255,.7); animation: grow 3s ease-in-out infinite alternate; }
  @keyframes grow { from{width:52%} to{width:78%} }

  /* ── Лендинг-часть (герой) ── */
  .hero { text-align:center; padding:3.4rem 1rem 2.4rem; }
  .hero .kicker {
    display:inline-flex; align-items:center; gap:.5rem; font-size:.76rem; color:var(--neon-2);
    border:1px solid rgba(47,123,255,.35); background:var(--neon-soft);
    border-radius:100px; padding:.35rem .85rem; margin-bottom:1.2rem; font-weight:600;
  }
  .hero h1 { font-size:2.7rem; font-weight:800; letter-spacing:-.035em; line-height:1.1; }
  .hero h1 em {
    font-style:normal; color:var(--neon-2);
    text-shadow:0 0 22px rgba(47,123,255,.6);
  }
  .hero p { color:var(--muted); max-width:560px; margin:1rem auto 0; font-size:.95rem; line-height:1.55; }
  .hero .cta { display:flex; gap:.7rem; justify-content:center; margin-top:1.7rem; flex-wrap:wrap; }
  .cta-trial { display:inline-block; margin:1.1rem auto 0; text-align:center; text-decoration:none;
    padding:.72rem 1.7rem; border-radius:100px; border:1px solid rgba(47,123,255,.55);
    color:#fff; font-weight:800; font-size:.92rem; letter-spacing:-.01em;
    background:linear-gradient(135deg, #2f7bff, #1b5fd6);
    box-shadow:0 14px 34px -16px rgba(47,123,255,.85);
    transition:transform .25s, box-shadow .25s, filter .25s; }
  .cta-trial:hover { transform:translateY(-2px); filter:brightness(1.07);
    box-shadow:0 20px 46px -16px rgba(47,123,255,.95); }
  .cta-trial-sub { text-align:center; color:var(--muted); font-size:.74rem; margin-top:.7rem; }
  .float {
    margin:2.6rem auto 0; max-width:940px; border-radius:20px; border:1px solid var(--line);
    background: linear-gradient(180deg, rgba(16,20,29,.9), rgba(12,15,22,.9));
    box-shadow: 0 40px 90px -40px rgba(47,123,255,.35), 0 0 0 1px rgba(47,123,255,.06);
    padding:1.4rem; text-align:left;
  }
  .feat { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-top:2.4rem; }
  .feat .f {
    border:1px solid var(--line); border-radius:16px; padding:1.15rem 1.2rem;
    background:linear-gradient(180deg,var(--panel-2),var(--panel));
  }
  .feat .f .ic { font-size:1.25rem; }
  .feat .f h3 { font-size:.92rem; margin:.55rem 0 .35rem; }
  .feat .f p { color:var(--muted); font-size:.8rem; line-height:1.5; }


  /* ── 3D-карусель логотипов соцсетей ── */
  .ring-stage { perspective:1200px; margin:3rem auto 0; max-width:960px; height:210px; display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden; }
  .ring-stage:before { content:""; position:absolute; inset:auto 0 -10px; height:80px; max-width:100%; background:radial-gradient(ellipse at center, rgba(47,123,255,.18), transparent 70%); filter:blur(8px); }
  .ring { position:relative; width:180px; height:180px; transform-style:preserve-3d; animation:spin 26s linear infinite; }
  .ring:hover { animation-play-state:paused; }
  @keyframes spin { from { transform:rotateY(0deg); } to { transform:rotateY(360deg); } }
  .ring .tile {
    position:absolute; top:50%; left:50%; width:92px; height:92px; margin:-46px 0 0 -46px;
    border-radius:20px; display:grid; place-items:center;
    background:linear-gradient(180deg, rgba(18,23,33,.95), rgba(11,15,22,.95));
    border:1px solid var(--line); box-shadow:0 18px 40px -18px rgba(0,0,0,.8), 0 0 22px -6px rgba(47,123,255,.4);
    transform-style:preserve-3d;
  }
  .ring .tile svg { width:46px; height:46px; }
  .ring .tile span.lbl { position:absolute; bottom:-1.35rem; font-size:.66rem; color:var(--muted); letter-spacing:.02em; white-space:nowrap; }
  .ring-cap { text-align:center; color:var(--muted); font-size:.8rem; margin-top:2.6rem; }
  .ring-cap b { color:var(--text); }
  .ring-legal { text-align:center; color:var(--muted); opacity:.62; font-size:.66rem; margin-top:.35rem; line-height:1.4; padding:0 1rem; }

  @media (max-width:640px) {
    .ring-stage { height:150px; margin-top:1.8rem; overflow:hidden; }
    .ring { width:110px; height:110px; }
    .ring .tile { width:62px; height:62px; margin:-31px 0 0 -31px; border-radius:14px; }
    .ring .tile svg { width:30px; height:30px; }
    .ring .tile span.lbl { display:none; }
    .ring-cap { margin-top:2.2rem; }
  }


  /* ── КАК ЭТО РАБОТАЕТ — стопка карточек ── */
  .flow{max-width:1000px;margin:3.2rem auto 0}
  .flow .stack{position:relative}
  .flow .step{
    position:sticky;top:14px;display:flex;align-items:center;gap:2rem;
    height:80vh;min-height:80vh;max-height:80vh;margin-bottom:1.2rem;
    border:1px solid var(--line);border-radius:22px;
    background:linear-gradient(160deg, rgba(20,26,38,.98), rgba(10,14,21,.98));
    box-shadow:0 -1px 0 rgba(255,255,255,.03) inset, 0 30px 70px -40px rgba(0,0,0,.95);
    padding:2.4rem 2.6rem;overflow:hidden;
  }
  .flow .step:before{content:"";position:absolute;inset:0 auto auto 0;width:100%;height:1px;
    background:linear-gradient(90deg,transparent,rgba(47,123,255,.6),transparent)}
  .flow .step .peek{position:absolute;top:0;left:0;right:0;height:58px;display:flex;align-items:center;gap:.7rem;
    padding:0 2.6rem;font-weight:700;font-size:1rem;
    background:linear-gradient(180deg, rgba(17,23,36,.99) 45%, rgba(17,23,36,0))};
    border-radius:22px 22px 0 0}
  .flow .step .big{flex:0 0 170px;display:grid;place-items:center;position:relative}
  .flow .step .big .emoji{font-size:3.6rem;animation:floaty2 3.4s ease-in-out infinite;
    filter:drop-shadow(0 6px 16px rgba(47,123,255,.85))}
  .flow .step .big .glow{position:absolute;width:150px;height:150px;border-radius:50%;
    background:radial-gradient(circle at 50% 45%, rgba(47,123,255,.5), transparent 68%);
    animation:gpulse2 2.8s ease-in-out infinite}
  @keyframes floaty2{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
  @keyframes gpulse2{0%,100%{transform:scale(.85);opacity:.5}50%{transform:scale(1.15);opacity:1}}
  .flow .step .txt{flex:1;min-width:0;padding-top:1rem}
  .flow .step .num{font-size:.7rem;font-weight:700;color:var(--neon-2);letter-spacing:.1em}
  .flow .step h4{font-size:1.5rem;font-weight:800;letter-spacing:-.02em;margin:.35rem 0 .6rem}
  .flow .step p{color:var(--muted);font-size:.94rem;line-height:1.62;max-width:52ch}
  .flow .step .tags{margin-top:.8rem;display:flex;flex-wrap:wrap;gap:.35rem}
  .flow .step .tags span{font-size:.66rem;font-weight:600;color:var(--neon-2);
    border:1px solid rgba(47,123,255,.4);background:var(--neon-soft);border-radius:100px;padding:.16rem .55rem}

  .nets{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem;width:150px;animation:floaty2 4s ease-in-out infinite}
  .nets .nt{aspect-ratio:1/1;display:grid;place-items:center}
  .nets .nt svg{width:52px;height:52px;filter:drop-shadow(0 5px 14px rgba(0,0,0,.6))}
  .nets .nt:nth-child(7){grid-column:1 / -1;justify-self:center}

  @media (max-width:820px){
    .flow .step{flex-direction:column;justify-content:center;height:80vh;min-height:80vh;max-height:80vh;padding:1.6rem 1.3rem;gap:1rem}
    .flow .step .peek{height:56px;padding:0 1.3rem;font-size:.9rem}
    .flow .step .big{flex:none}
    .flow .step .big .emoji{font-size:2.8rem}
    .flow .step .txt{padding-top:.4rem}
    .flow .step h4{font-size:1.25rem}
    .flow .step p{font-size:.87rem}
    .nets{width:132px}
    .nets .nt svg{width:44px;height:44px}
  }


  /* ── 3D-карточки типов контента ── */
  .ctypes { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin:2.4rem auto 0; max-width:900px; perspective:1100px; }
  .ctype {
    position:relative; text-align:center; padding:1.5rem 1rem 1.3rem; border-radius:18px;
    border:1px solid var(--line); background:linear-gradient(180deg,var(--panel-2),var(--panel));
    transform:rotateX(8deg); transform-style:preserve-3d;
    transition:transform .35s ease, border-color .35s, box-shadow .35s;
    box-shadow:0 22px 44px -26px rgba(0,0,0,.9);
  }
  .ctype:hover { transform:rotateX(0deg) translateY(-8px) scale(1.03); border-color:rgba(47,123,255,.55);
    box-shadow:0 30px 60px -22px rgba(47,123,255,.55); }
  .ctype .cico { font-size:1.9rem; transform:translateZ(30px); }
  .ctype h4 { font-size:.95rem; margin:.6rem 0 .3rem; transform:translateZ(20px); }
  .ctype p { font-size:.76rem; color:var(--muted); line-height:1.5; transform:translateZ(10px); }
  .ctype p.csub { font-size:.7rem; opacity:.75; margin-top:.4rem; transform:translateZ(8px); }
  .ctype .ctag { display:inline-block; margin-top:.6rem; font-size:.66rem; font-weight:600; color:var(--neon-2);
    border:1px solid rgba(47,123,255,.4); background:var(--neon-soft); border-radius:100px; padding:.14rem .55rem; }
  /* ── ЗАЧЕМ НУЖНА УНИКАЛИЗАЦИЯ ── */
  .why { max-width:640px; margin:3.4rem auto 0; }
  .why-lead { color:var(--muted); font-size:.94rem; line-height:1.65; text-align:center; margin-bottom:1.8rem; }
  .why-lead b { color:var(--text); }
  .why-flow { display:flex; flex-direction:column; align-items:center; }
  .ws { text-align:center; width:100%; }
  .ws-t { font-size:1.05rem; font-weight:700; line-height:1.45; }
  .ws-d { font-size:.82rem; color:var(--muted); line-height:1.5; margin-top:.25rem; }
  .ws-v { margin-top:.5rem; font-size:.95rem; font-weight:700; color:var(--text); }
  .ws-v b { color:#fff; }
  .warr { margin:.7rem 0; width:14px; height:40px; position:relative; }
  .warr:before { content:""; position:absolute; left:50%; top:0; transform:translateX(-50%); width:2px; height:28px; background:rgba(255,255,255,.85); border-radius:2px; }
  .warr:after { content:""; position:absolute; left:50%; bottom:0; transform:translateX(-50%); border-left:6px solid transparent; border-right:6px solid transparent; border-top:10px solid rgba(255,255,255,.95); }
  .why-total { text-align:center; margin-top:1.8rem; padding:1.2rem 1.4rem; border-radius:18px;
    border:1px solid rgba(47,123,255,.5); background:linear-gradient(160deg, rgba(47,123,255,.12), rgba(10,14,21,.96));
    box-shadow:0 28px 60px -34px rgba(47,123,255,.7); font-size:1.35rem; font-weight:800; letter-spacing:-.02em; }
  .why-total em { font-style:normal; color:var(--neon-2); }
  @media (max-width:520px){ .ws-t{font-size:.98rem} .why-total{font-size:1.1rem} }

  .flow-title { display:flex; align-items:center; gap:1rem; text-align:center; font-size:.74rem; text-transform:uppercase; letter-spacing:.16em; color:var(--muted); margin-bottom:2rem; }
  .flow-title:before, .flow-title:after { content:""; flex:1; height:1px; background:var(--line); }
  .flow-title b { color:var(--text); }
  .ctypes-title { display:flex; align-items:center; gap:1rem; text-align:center; font-size:.74rem; text-transform:uppercase; letter-spacing:.16em; color:var(--muted); margin-top:2.6rem; }
  .ctypes-title:before, .ctypes-title:after { content:""; flex:1; height:1px; background:var(--line); }
  .ctypes-title b { color:var(--text); }

  @media (max-width:640px) {
    .ctypes { grid-template-columns:1fr; gap:.7rem; perspective:900px; }
    .ctype { transform:rotateX(6deg); padding:1.1rem 1rem; }
    .ctype:hover { transform:rotateX(0deg) translateY(-4px); }
  }

  .sep { margin:3rem 0 1.6rem; display:flex; align-items:center; gap:1rem; color:var(--muted); font-size:.74rem; text-transform:uppercase; letter-spacing:.14em; }
  .sep:before, .sep:after { content:""; flex:1; height:1px; background:var(--line); }

  /* ── ТАРИФЫ — карусель карточек ── */
  .pland-note{color:var(--muted);font-size:.82rem;text-align:center;margin:-1rem 0 1.4rem;line-height:1.5}
  .fx-carousel .rail{display:flex;gap:.9rem;overflow-x:auto;overflow-y:visible;scroll-snap-type:x mandatory;
    padding:1.6rem .8rem 1.3rem;-webkit-overflow-scrolling:touch;scrollbar-width:none}
  .fx-carousel .rail::-webkit-scrollbar{display:none}
  .fx-carousel .pcard{flex:0 0 240px;min-height:540px;scroll-snap-align:center;padding:1.9rem 1.4rem;
    display:flex;flex-direction:column;justify-content:flex-start;position:relative;overflow:visible;
    border:1px solid var(--line);border-radius:20px;
    background:linear-gradient(160deg, rgba(20,26,38,.98), rgba(10,14,21,.98));
    box-shadow:0 -1px 0 rgba(255,255,255,.03) inset, 0 30px 70px -40px rgba(0,0,0,.95)}
  .fx-carousel .pcard:before{content:"";position:absolute;inset:0 auto auto 0;width:100%;height:1px;
    background:linear-gradient(90deg,transparent,rgba(47,123,255,.6),transparent)}
  .fx-carousel .pcard .pname{font-size:.9rem;font-weight:700;color:var(--muted)}
